generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  interactions UserInteraction[]
  preferences  UserPreferences?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Article {
  id          String   @id @default(cuid())
  url         String   @unique
  title       String
  summary     String?
  source      String
  category    String
  relevance   Int // 0-100 score from AI
  publishedAt DateTime?
  scrapedAt   DateTime @default(now())

  // Relation for user interactions
  interactions UserInteraction[]

  @@index([category])
  @@index([relevance])
  @@index([scrapedAt])
}

// Track user interactions with articles (likes, reads, etc.)
model UserInteraction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  interactionType String // "like", "read", "dislike"
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([articleId])
  @@index([createdAt])
}

// Store learned user preferences
model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // JSON stringified preferences learned from interactions
  preferredCategories String @default("{}") // {"Debate": 0.9, "Tendencia": 0.7}
  preferredSources    String @default("{}") // {"La Nación": 0.8}
  preferredTopics     String @default("[]") // ["streaming", "rosario"]

  // Stats
  totalInteractions Int       @default(0)
  lastAnalyzedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
